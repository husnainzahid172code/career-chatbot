# ─── Backend ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_secret
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot_ai
GEMINI_API_KEY=replace_with_your_real_gemini_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ─── Frontend (Vite - must use VITE_ prefix) ─────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_NAME=CareerPilot AI
VITE_APP_VERSION=2.0.0
VITE_API_PROVIDER=gemini
VITE_RATE_LIMIT=10
